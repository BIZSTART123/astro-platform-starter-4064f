---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <div class="container nf">
    <h1>This pew is empty.</h1>
    <p>The page you're looking for isn't here. <a href="/">Go back to the front of the church.</a></p>
  </div>
</Base>
<style>
  .nf { padding-block: 80px; display: grid; gap: 16px; }
  h1 { font-size: clamp(36px, 6vw, 56px); color: var(--mahogany); }
</style>
