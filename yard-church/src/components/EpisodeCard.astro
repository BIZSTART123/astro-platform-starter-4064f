---
import type { CollectionEntry } from 'astro:content';
interface Props { episode: CollectionEntry<'episodes'> }
const { data } = Astro.props.episode;
const num = String(data.number).padStart(2, '0');
---
<a class="card" href={`/episodes/${data.slug}`}>
  <div class="thumb">
    {data.thumbnail
      ? <img src={data.thumbnail} alt="" loading="lazy" />
      : <><span class="half then">Then</span><span class="half now">Now</span></>}
  </div>
  <div class="text">
    <span class="num">Episode {num}</span>
    <h3>{data.title}</h3>
    <p>{data.hook}</p>
  </div>
</a>

<style>
  .card { display: grid; grid-template-rows: auto 1fr; background: #fff; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; color: inherit; text-decoration: none; transition: transform .15s ease, box-shadow .15s ease; }
  .card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(28,36,32,.12); }
  .thumb { aspect-ratio: 16 / 9; display: grid; grid-template-columns: 1fr 1fr; }
  .thumb img { grid-column: 1 / -1; width: 100%; height: 100%; object-fit: cover; }
  .half { display: flex; align-items: flex-end; padding: 10px 12px; font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: #fff; text-shadow: 0 1px 6px rgba(0,0,0,.5); }
  .half.then { background: radial-gradient(130% 100% at 20% 10%, #f7d79a, #c99a52 45%, #6e8a72 85%); }
  .half.now { background: radial-gradient(110% 90% at 50% 0%, #4a3fb8, #1b1747 55%, #07070f); justify-content: flex-end; }
  .text { display: grid; gap: 6px; padding: 16px 18px 20px; align-content: start; }
  .num { font-size: 13px; font-weight: 600; color: var(--mahogany); letter-spacing: .06em; text-transform: uppercase; }
  h3 { font-family: var(--display); font-weight: 400; font-size: 24px; }
  p { color: var(--muted); font-size: 15px; }
</style>
