---
import Base from '../layouts/Base.astro';
import { BIZ, tel } from '../config';
---
<Base title="Request received | Inversa Rx Optical">
  <main class="msg">
    <p class="eyebrow">Request received</p>
    <h1>Thank you. We’ll be in touch shortly.</h1>
    <p>Someone from the Inversa Rx team will call to confirm your visit.{BIZ.phone && <> Need us sooner? <a href={tel(BIZ.phone)}>{BIZ.phone}</a></>}</p>
    <a class="btn btn-gold" href="/">Back to home</a>
  </main>
</Base>
<style>
  .msg { min-height: 100vh; display: grid; place-content: center; gap: 18px; text-align: center; padding: 32px 16px; max-width: 640px; margin: auto; }
  h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); }
  .btn { justify-self: center; margin-top: 10px; }
</style>
