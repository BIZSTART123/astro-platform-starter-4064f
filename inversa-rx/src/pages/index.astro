---
import Base from '../layouts/Base.astro';
import { BIZ, tel } from '../config';

const chart = [
  { t: 'E', s: 7.2 },
  { t: 'S E E', s: 4.4 },
  { t: 'C L E A R', s: 3 },
  { t: 'B R O N X', s: 2.1 },
  { t: 'F O R  L E S S', s: 1.5 },
  { t: 'I N V E R S A  R X', s: 1.05 },
];
const socials = BIZ.socials.filter((s) => s.url);
const callOrBook = BIZ.phone ? { href: tel(BIZ.phone), label: `Call ${BIZ.phone}` } : { href: '#book', label: 'Request a visit' };
---
<Base>
  <!-- NAV -->
  <header class="nav">
    <div class="wrap nav-in">
      <a href="/" class="brand" aria-label={`${BIZ.name} home`}>
        <svg viewBox="0 0 64 32" width="40" height="20" aria-hidden="true"><path d="M2 16C9 6 19 2 32 2s23 4 30 14c-7 10-17 14-30 14S9 26 2 16z" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="32" cy="16" r="7" fill="var(--green)"/></svg>
        <span>Inversa<b>Rx</b></span>
      </a>
      <nav aria-label="Main">
        <a href="#pricing">Pricing</a>
        <a href="#visit">Your visit</a>
        <a href="#pharmacy">Pharmacy</a>
        <a href="#story">Our story</a>
      </nav>
      <a class="btn btn-gold nav-cta" href="#book">Book an exam</a>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-in">
        <div class="hero-copy">
          <p class="eyebrow eyebrow-light">Inversa Rx Optical · {BIZ.neighborhood}</p>
          <h1>Clear sight shouldn’t cost a&nbsp;fortune.</h1>
          <p class="lede">
            Eye exams by an ophthalmologist, glasses and contact lenses for every style and budget, right here in the Bronx.
            <strong>Your exam is free when you buy glasses.</strong>
          </p>
          <div class="hero-ctas">
            <a class="btn btn-gold" href="#book">Book an eye exam</a>
            <a class="btn btn-ghost" href="#pricing">See pricing</a>
          </div>
        </div>

        <figure class="chart" aria-label="An eye chart that comes into focus, reading: See clear, Bronx, for less, Inversa Rx">
          <div class="chart-card">
            {chart.map((row, i) => (
              <div class="row" style={`--s:${row.s}rem; --d:${0.25 + i * 0.22}s`}>
                <span class="num">{i + 1}</span>
                <span class="letters" aria-hidden="true">{row.t}</span>
              </div>
            ))}
            <div class="redline" aria-hidden="true"></div>
          </div>
          <figcaption>Read the bottom line? Come see us anyway.</figcaption>
        </figure>
      </div>
    </section>

    <!-- PRICING -->
    <section id="pricing" class="section pricing">
      <div class="wrap">
        <p class="eyebrow reveal">Straightforward pricing</p>
        <h2 class="reveal">Two prices.<br />No surprises.</h2>
        <div class="price-grid">
          <article class="price reveal">
            <p class="price-tag">{BIZ.pricing.examWithGlasses}</p>
            <h3>Eye exam with your glasses</h3>
            <p>Buy your glasses with us and your standard eye examination is on the house.</p>
          </article>
          <article class="price price-dark reveal">
            <p class="price-tag">{BIZ.pricing.comprehensive}</p>
            <h3>Comprehensive care</h3>
            <p>A thorough, comprehensive visit with our ophthalmologist, at one clear price.</p>
          </article>
        </div>
        <p class="fineprint reveal">
          {BIZ.insurance || 'Questions about insurance or what’s included? Call or stop in and we’ll walk you through it.'}
        </p>
      </div>
    </section>

    <!-- VISIT -->
    <section id="visit" class="section visit">
      <div class="wrap">
        <p class="eyebrow reveal">Your visit</p>
        <h2 class="reveal">From blurry to brilliant in three steps.</h2>
        <ol class="steps">
          <li class="reveal">
            <span class="step-n">01</span>
            <h3>A thorough exam</h3>
            <p>An ophthalmologist, a medical eye doctor, checks your eyes carefully. No rushing.</p>
          </li>
          <li class="reveal">
            <span class="step-n">02</span>
            <h3>An honest recommendation</h3>
            <p>Depending on what your eyes need, the doctor recommends prescription glasses or contact lenses.</p>
          </li>
          <li class="reveal">
            <span class="step-n">03</span>
            <h3>Frames you’ll love</h3>
            <p>Pick from a selection of eyewear for different styles and budgets, from everyday to statement.</p>
          </li>
        </ol>
      </div>
    </section>

    <!-- WHY -->
    <section class="section why">
      <div class="wrap why-in">
        <p class="eyebrow eyebrow-light reveal">Why we’re here</p>
        <blockquote class="reveal">
          <p>“People of colour generally face lower eye care utilisation and greater financial barriers to vision services.”</p>
          <cite>National Institutes of Health, as cited in the Jamaica Observer</cite>
        </blockquote>
        <p class="why-body reveal">
          For a lot of families, the cost of an eye exam and a pair of glasses is reason enough to put it off. We opened Inversa Rx Optical so
          that cost isn’t the thing standing between our neighbours and seeing clearly.
        </p>
      </div>
    </section>

    <!-- PHARMACY -->
    <section id="pharmacy" class="section pharmacy">
      <div class="wrap pharm-in">
        <div class="pharm-badge reveal" aria-hidden="true">
          <span>Rx</span>
        </div>
        <div>
          <p class="eyebrow reveal">Also from Inversa Rx</p>
          <h2 class="reveal">Inversa Rx Pharmacy</h2>
          <p class="reveal pharm-copy">
            Our neighbourhood pharmacy, open since August 2026, puts essential health products and services within reach, conveniently
            and affordably. Fill a prescription, pick up the essentials and get your eyes checked, all with one family-run team.
          </p>
          <a class="btn btn-ghost reveal" href="#contact">Contact the pharmacy</a>
        </div>
      </div>
    </section>

    <!-- STORY -->
    <section id="story" class="section story">
      <div class="wrap story-in">
        <div>
          <p class="eyebrow reveal">Our story</p>
          <h2 class="reveal">A Jamaican family. A Bronx legacy. A new chapter.</h2>
        </div>
        <div class="story-body">
          <p class="reveal">
            Inversa Rx is led by owner and CEO <strong>Haywood Hawthorne</strong>, son of Lowell Hawthorne, who started Golden Krust in the
            Bronx 39 years ago. That one bakery became more than 100 locations across the United States, and it showed what a Caribbean
            family business could build here.
          </p>
          <p class="reveal">
            Now the next generation is taking that same spirit into health care, guided by the Christian values the Hawthorne family has
            always lived by. The Bronx has a special place in the story of Jamaican and Caribbean immigration to America, and we believe in
            investing right back into it.
          </p>
          <div class="timeline reveal" role="list">
            <div role="listitem"><b>39 years ago</b><span>Golden Krust opens in the Bronx</span></div>
            <div role="listitem"><b>Aug 2026</b><span>Inversa Rx Pharmacy opens</span></div>
            <div role="listitem"><b>Oct 2026</b><span>Inversa Rx Optical launches</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- PRESS -->
    <section class="press">
      <div class="wrap press-in reveal">
        <p class="eyebrow">As featured in</p>
        <a href={BIZ.press.url} target="_blank" rel="noopener">
          <span class="press-outlet">{BIZ.press.outlet}</span>
          <span class="press-head">“{BIZ.press.headline}”</span>
          <span class="press-date">{BIZ.press.date} · Read the article →</span>
        </a>
      </div>
    </section>

    <!-- BOOK -->
    <section id="book" class="section book">
      <div class="wrap book-in">
        <div>
          <p class="eyebrow eyebrow-light reveal">Book a visit</p>
          <h2 class="reveal">Let’s get you seeing clearly.</h2>
          <p class="reveal book-lede">
            Send a request and our team will call you to confirm a time.
            {BIZ.phone && <>Prefer to talk now? <a href={tel(BIZ.phone)}>{BIZ.phone}</a>.</>}
          </p>
        </div>
        <form name="appointment" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="company" class="form reveal">
          <input type="hidden" name="form-name" value="appointment" />
          <p class="hp"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>
          <label>Full name<input name="name" required autocomplete="name" /></label>
          <div class="two">
            <label>Phone<input name="phone" type="tel" required autocomplete="tel" /></label>
            <label>Email <small>(optional)</small><input name="email" type="email" autocomplete="email" /></label>
          </div>
          <div class="two">
            <label>I’m interested in
              <select name="service">
                <option>Eye exam + new glasses</option>
                <option>Comprehensive visit</option>
                <option>Contact lenses</option>
                <option>Pharmacy question</option>
              </select>
            </label>
            <label>Best time to reach me
              <select name="when">
                <option>Morning</option>
                <option>Afternoon</option>
                <option>Evening</option>
              </select>
            </label>
          </div>
          <button class="btn btn-gold" type="submit">Request my visit</button>
          <p class="form-note">Please don’t include medical details here. We’ll go over everything in person.</p>
        </form>
      </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="section contact">
      <div class="wrap contact-grid">
        <div class="reveal">
          <p class="eyebrow">Find us</p>
          <h3>{BIZ.address || BIZ.neighborhood}</h3>
          {BIZ.mapsUrl && <a href={BIZ.mapsUrl} target="_blank" rel="noopener">Get directions →</a>}
        </div>
        <div class="reveal">
          <p class="eyebrow">Hours</p>
          {BIZ.hours.length
            ? <dl class="hours">{BIZ.hours.map((h) => <><dt>{h.days}</dt><dd>{h.time}</dd></>)}</dl>
            : <p>Call or send a request for today’s hours.</p>}
        </div>
        <div class="reveal">
          <p class="eyebrow">Talk to us</p>
          {BIZ.phone && <p><a href={tel(BIZ.phone)}>{BIZ.phone}</a></p>}
          {BIZ.email && <p><a href={`mailto:${BIZ.email}`}>{BIZ.email}</a></p>}
          {!BIZ.phone && !BIZ.email && <p><a href="#book">Send us a request</a></p>}
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap foot-in">
      <p><b>Inversa Rx</b> Optical &amp; Pharmacy · {BIZ.neighborhood}</p>
      {socials.length > 0 && <p class="socials">{socials.map((s) => <a href={s.url} target="_blank" rel="noopener">{s.label}</a>)}</p>}
      <p class="copy">© {new Date().getFullYear()} Inversa Rx. This site is for general information and isn’t medical advice.</p>
    </div>
  </footer>

  <a class="mobile-cta btn btn-gold" href={callOrBook.href}>{callOrBook.label}</a>
</Base>

<style>
  /* NAV */
  .nav { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--ink) 92%, transparent); backdrop-filter: blur(10px); color: var(--paper); }
  .nav-in { display: flex; align-items: center; gap: 24px; height: 68px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font: 600 1.35rem var(--display); color: var(--paper); }
  .brand b { color: var(--gold); font-weight: 700; margin-left: 2px; }
  .nav nav { display: flex; gap: 26px; margin-left: auto; }
  .nav nav a { text-decoration: none; font-size: .95rem; opacity: .8; }
  .nav nav a:hover { opacity: 1; }
  .nav-cta { padding: .65em 1.2em; font-size: .92rem; }
  @media (max-width: 860px) { .nav nav { display: none; } .nav-cta { margin-left: auto; } }

  /* HERO */
  .hero { background: radial-gradient(1200px 600px at 85% 20%, #1f3550 0%, transparent 60%), var(--ink); color: var(--paper); overflow: hidden; }
  .hero-in { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 56px; align-items: center; padding: clamp(56px, 9vw, 120px) 0; }
  .hero h1 { font-size: clamp(2.7rem, 6.4vw, 5.2rem); margin: 18px 0 22px; }
  .eyebrow-light { color: var(--gold); }
  .lede { font-size: 1.15rem; color: #c9d1dc; max-width: 34em; }
  .lede strong { color: var(--paper); }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .chart { margin: 0; }
  .chart-card {
    position: relative; background: #fbf8f1; color: var(--ink); border-radius: 10px;
    padding: 34px 28px 30px; box-shadow: 0 40px 80px -30px #000a, 0 0 0 10px #ffffff10;
    transform: rotate(1.5deg);
  }
  .row { display: grid; grid-template-columns: 22px 1fr; align-items: center; margin: 0 0 .5em; }
  .num { font: 500 .7rem var(--mono); color: #9aa3ae; }
  .letters {
    justify-self: center; white-space: pre; font: 700 var(--s)/1.05 var(--sans); letter-spacing: .02em;
    filter: blur(9px); opacity: .35; animation: focus 1.4s cubic-bezier(.2,.7,.2,1) var(--d) forwards;
  }
  .row:first-child .letters { font-family: var(--sans); }
  .row:nth-child(6) .letters { color: var(--green); }
  @keyframes focus { to { filter: blur(0); opacity: 1; } }
  .redline { height: 2px; background: #d64545; margin: 6px 0 0 22px; transform-origin: left; transform: scaleX(0); animation: grow .8s ease 1.9s forwards; }
  @keyframes grow { to { transform: scaleX(1); } }
  .chart figcaption { text-align: center; margin-top: 22px; font: 500 .8rem var(--mono); color: #8d99a8; letter-spacing: .04em; }
  @media (max-width: 860px) { .hero-in { grid-template-columns: 1fr; } .chart-card { transform: none; } }
  @media (max-width: 420px) { .chart-card { padding: 26px 14px; } .row { --s: calc(var(--s) * .8); } }

  /* PRICING */
  .pricing h2 { margin: 14px 0 48px; }
  .price-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .price { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(28px, 4vw, 48px); }
  .price-dark { background: var(--green); color: #fff; border-color: transparent; }
  .price-tag { font: 700 clamp(3.4rem, 8vw, 5.6rem)/1 var(--display); letter-spacing: -0.04em; margin-bottom: 18px; }
  .price h3 { font-size: 1.5rem; margin-bottom: 10px; }
  .price p:last-child { color: var(--muted); }
  .price-dark p:last-child { color: #dff3ea; }
  .fineprint { margin-top: 22px; color: var(--muted); font-size: .95rem; }
  @media (max-width: 700px) { .price-grid { grid-template-columns: 1fr; } }

  /* VISIT */
  .visit { background: var(--paper-2); }
  .visit h2 { margin: 14px 0 48px; max-width: 14em; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .steps li { border-top: 2px solid var(--ink); padding-top: 20px; }
  .step-n { font: 600 .85rem var(--mono); color: var(--green); }
  .steps h3 { font-size: 1.45rem; margin: 10px 0 8px; }
  .steps p { color: var(--muted); }
  @media (max-width: 760px) { .steps { grid-template-columns: 1fr; gap: 32px; } }

  /* WHY */
  .why { background: var(--ink); color: var(--paper); }
  .why-in { max-width: 900px; }
  blockquote { margin: 22px 0 28px; }
  blockquote p { font: 500 clamp(1.7rem, 3.8vw, 2.7rem)/1.2 var(--display); letter-spacing: -0.01em; }
  cite { display: block; margin-top: 16px; font: 500 .8rem var(--mono); font-style: normal; color: #8d99a8; }
  .why-body { font-size: 1.15rem; color: #c9d1dc; max-width: 40em; }

  /* PHARMACY */
  .pharm-in { display: grid; grid-template-columns: auto 1fr; gap: clamp(32px, 6vw, 80px); align-items: center; }
  .pharm-badge { width: clamp(140px, 22vw, 240px); aspect-ratio: 1; border-radius: 50%; background: var(--green-soft); display: grid; place-items: center; border: 2px dashed var(--green); }
  .pharm-badge span { font: 700 clamp(3rem, 7vw, 5rem) var(--display); color: var(--green); font-style: italic; }
  .pharmacy h2 { margin: 14px 0 18px; }
  .pharm-copy { color: var(--muted); max-width: 36em; margin-bottom: 26px; font-size: 1.08rem; }
  @media (max-width: 700px) { .pharm-in { grid-template-columns: 1fr; } }

  /* STORY */
  .story { background: var(--paper-2); }
  .story-in { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 6vw, 80px); }
  .story h2 { margin-top: 14px; }
  .story-body p { margin-bottom: 18px; font-size: 1.08rem; color: #2e3a4b; }
  .timeline { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 30px; }
  .timeline div { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 16px; }
  .timeline b { display: block; font: 600 .78rem var(--mono); color: var(--green); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 6px; }
  .timeline span { font-size: .95rem; }
  @media (max-width: 860px) { .story-in { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .timeline { grid-template-columns: 1fr; } }

  /* PRESS */
  .press { border-block: 1px solid var(--line); padding: 44px 0; }
  .press-in { display: flex; gap: 32px; align-items: center; flex-wrap: wrap; }
  .press a { text-decoration: none; display: grid; gap: 4px; flex: 1; min-width: 260px; }
  .press-outlet { font: 700 1.5rem var(--display); }
  .press-head { font-size: 1.05rem; }
  .press-date { font: 500 .8rem var(--mono); color: var(--green); }
  .press a:hover .press-head { text-decoration: underline; }

  /* BOOK */
  .book { background: var(--ink); color: var(--paper); }
  .book-in { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .book h2 { margin: 14px 0 18px; }
  .book-lede { color: #c9d1dc; font-size: 1.1rem; }
  .book-lede a { color: var(--gold); }
  .form { background: var(--ink-2); border-radius: var(--radius); padding: clamp(22px, 4vw, 36px); display: grid; gap: 16px; }
  .form label { display: grid; gap: 6px; font-size: .9rem; font-weight: 500; color: #c9d1dc; }
  .form small { font-weight: 400; opacity: .7; }
  .form input, .form select { font: inherit; color: var(--paper); background: var(--ink); border: 1px solid #34465f; border-radius: 10px; padding: 12px 14px; width: 100%; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .form .btn { justify-self: start; margin-top: 4px; }
  .form-note { font-size: .82rem; color: #8d99a8; }
  .hp { position: absolute; left: -9999px; }
  @media (max-width: 860px) { .book-in { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .two { grid-template-columns: 1fr; } }

  /* CONTACT */
  .contact-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .contact h3 { font-size: 1.5rem; margin-top: 10px; }
  .contact p:not(.eyebrow) { margin-top: 10px; }
  .hours { display: grid; grid-template-columns: auto 1fr; gap: 4px 18px; margin: 10px 0 0; }
  .hours dd { margin: 0; }
  @media (max-width: 760px) { .contact-grid { grid-template-columns: 1fr; } }

  /* FOOTER */
  .footer { background: var(--ink); color: #8d99a8; padding: 36px 0 110px; font-size: .9rem; }
  .foot-in { display: grid; gap: 8px; }
  .footer b { color: var(--paper); }
  .socials { display: flex; gap: 16px; }
  @media (min-width: 861px) { .footer { padding-bottom: 36px; } }

  /* MOBILE STICKY CTA */
  .mobile-cta { position: fixed; left: 16px; right: 16px; bottom: 16px; justify-content: center; z-index: 30; box-shadow: 0 12px 30px -10px #0008; }
  @media (min-width: 861px) { .mobile-cta { display: none; } }
</style>
